# Copia este archivo como .env y ajusta los valores.
# Esta configuración local coincide con la base de datos usada por la práctica.
DB_HOST=instancia-rds.example.amazonaws.com
DB_PORT=3306
DB_USER=application_user
DB_PASSWORD=REEMPLAZAR_CON_SECRET_MANAGER
DB_NAME=vehiculo_iot
DB_CONNECT_TIMEOUT=5

APP_HOST=0.0.0.0
APP_PORT=8000

# Firma HS256; genera un valor aleatorio de alta entropía y nunca lo publiques.
JWT_SECRET=REEMPLAZAR_CON_SECRET_MANAGER
JWT_ISSUER=iot-car-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Tokens permanentes de hardware, uno por vehículo. No uses este valor literal.
# Genera secretos aleatorios y guarda el JSON únicamente en el .env de EC2.
DEVICE_TOKENS={"1":"REEMPLAZAR_CON_SECRET_DEVICE_1"}

# Orígenes exactos, separados por comas.
CORS_ORIGINS=https://isaaias-cloud.github.io,http://localhost,http://localhost:5500
